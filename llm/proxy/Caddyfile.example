# Не подключено. Фрагмент для будущего HTTPS на хосте.
#
# LiteLLM слушает только 127.0.0.1:4000. Контейнерный Caddy
# (ai-impulse-tls-gate) до этого адреса не достучится: его 127.0.0.1 — это
# сам контейнер. Фрагмент имеет смысл только в Caddy или Apache на хосте.
#
# Не включать, пока не проверена авторизация, и не менять чужой reverse proxy
# без отдельного подтверждения.

# llm.example.internal {
# 	reverse_proxy 127.0.0.1:4000
# }
