POSTGRES_USER=intime
POSTGRES_PASSWORD=intime
POSTGRES_DB=intime
POSTGRES_HOST=db
POSTGRES_PORT=5432

APP_NAME=InTime

# Пустой ключ выключает ассистента. Ключ приложения: llm/secrets/intime-app.key
# Не используйте LITELLM_MASTER_KEY. 127.0.0.1 внутри контейнера backend — это не хост,
# поэтому здесь адрес, с которого контейнер достучится до шлюза на хосте.
LLM_API_KEY=
LLM_BASE_URL=http://192.168.31.228:4000/v1
LLM_MODEL=qwen3-32b
LLM_TIMEOUT=180
# GigaAM на порту хоста 9000. Ключ сервис не проверяет, но пустым его оставлять нельзя.
STT_API_KEY=local
STT_BASE_URL=http://host.docker.internal:9000/v1
STT_MODEL=gigaam
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Пользователь слоя /api без cookie. Не секрет.
COMPAT_USER_LOGIN=anna

# Шлюз LiteLLM. Master key только для выпуска и отзыва ключей, не для приложений.

