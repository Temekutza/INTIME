        <mxCell id="e_user_sessions" value="ON DELETE CASCADE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=18;html=1;endArrow=ERzeroToMany;endFill=0;startArrow=ERmandOne;startFill=0;strokeWidth=1;strokeColor=#5B6770;fontSize=12;fontColor=#3D474F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="users" target="sessions"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
