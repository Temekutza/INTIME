POSTGRES_USER=aivritm
POSTGRES_PASSWORD=aivritm
POSTGRES_DB=aivritm
POSTGRES_HOST=db
POSTGRES_PORT=5432

APP_NAME=Aivritm2

# Пустой ключ выключает ассистента, распознавание и синтез.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Шлюз LiteLLM. Master key только для выпуска и отзыва ключей, не для приложений.
LITELLM_MASTER_KEY=
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=
LITELLM_DB_NAME=litellm
LITELLM_DB_PORT=5436
