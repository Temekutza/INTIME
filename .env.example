POSTGRES_USER=intime
POSTGRES_PASSWORD=intime
POSTGRES_DB=intime
POSTGRES_HOST=db
POSTGRES_PORT=5432

APP_NAME=InTime

# Пустой ключ выключает ассистента, распознавание и синтез.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Пользователь слоя /api без cookie. Не секрет.
COMPAT_USER_LOGIN=anna

# Шлюз LiteLLM. Master key только для выпуска и отзыва ключей, не для приложений.

